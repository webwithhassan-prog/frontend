{
  "redirects": [
    {
      "source": "/((?!sw\\.js).*)",
      "has": [{ "type": "host", "value": "www.fitnesszone.ltd" }],
      "destination": "https://fitnesszone.ltd/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
