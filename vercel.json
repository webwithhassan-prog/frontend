{
  "redirects": [
    {
      "source": "/((?!sw\\.js).*)",
      "has": [{ "type": "host", "value": "www.fitnesszone.ltd" }],
      "destination": "https://fitnesszone.ltd/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(client|admin)", "destination": "/index.html" },
    { "source": "/(client|admin)/:path*", "destination": "/index.html" },
    { "source": "/(reset-password|complete-account)/:token", "destination": "/index.html" }
  ]
}
